# Required
DATABASE_URL=postgres://user:password@host/db        # Neon / Vercel Postgres connection string
SESSION_SECRET=                                       # random string, at least 32 characters

# File uploads (bills, bank statements, payment receipts). Create a *private* Vercel Blob store.
BLOB_READ_WRITE_TOKEN=

# Optional
SETUP_TOKEN=                                          # one-time code for /setup (first super admin); remove after setup
NEXT_PUBLIC_SITE_URL=https://elizabethmedicalcentre.com
ANTHROPIC_API_KEY=                                    # reads PDF bank statements and lab reports; optional
BREVO_API_KEY=                                        # emailing invoices
EMAIL_FROM=                                           # sender address verified in Brevo
NEXT_PUBLIC_NOTIFY_FORM_ENDPOINT=                     # Formspree-style endpoint for the "Notify me" form
